# Copy to .env.local if your setup differs from the defaults below. Everything
# here is optional: with Laragon running and api/ linked into C:\laragon\www,
# `npm run dev` works with no .env.local at all.

# Where the browser sends API calls. "/api" is the Vite dev proxy; point this
# at an absolute URL only when the frontend is served by something other than
# `npm run dev` (then add that origin to cors_origins in api/config.php).
# VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api. Change this if you aliased the API to a
# different path or host in Apache.
# VITE_API_PROXY_TARGET=http://localhost/qr-attendance-api/public
