# Dependencies and build output, per app
node_modules/
dist/

# Local environment files. .env.example is committed as the template; anything
# with real credentials must stay out of the repo.
.env
.env.*
!.env.example

# The API's local database credentials. api/config.example.php is the template.
api/config.php

# TypeScript incremental build cache
*.tsbuildinfo

# Per-machine Claude Code settings
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
