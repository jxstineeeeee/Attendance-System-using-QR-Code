Require all granted

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /students, /auth/login, ... all run through the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# A JSON API has nothing to list.
Options -Indexes
