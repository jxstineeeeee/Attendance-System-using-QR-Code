# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> Data API  (URL)
#   Project Settings -> API Keys  (publishable key)
#
# Only the publishable / anon key belongs here. It ships to the browser, so RLS
# is what protects the data. Never put the service-role or secret key in a
# VITE_ variable — Vite inlines those into the client bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
